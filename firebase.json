{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*/",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "sbrbioforge",
          "region": "asia-south2"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  },
  "projects": {
    "default": "sbrempire"
  }
}
