# =====================================================================
# SBRBIOFORGE - ENVIRONMENT VARIABLES TEMPLATE
# =====================================================================
# Copy this to .env.local and fill in your actual values
# NEVER commit .env or .env.local files

# Google Cloud
SBR_GOOGLE_KEY_1=your-google-key-here
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-cloud-key.json

# AI APIs
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key
GROQ_API_KEY=your-groq-key

# Cloud Services
CLOUD_API_KEY=your-cloud-api-key
NVIDIA_API_KEY=your-nvidia-key

# Environmental Data APIs
WEATHER_API_KEY=your-weather-api-key
NASA_API_KEY=your-nasa-key
AIRNOW_API_KEY=your-airnow-key

# Media & Voice APIs
ELEVENLABS_KEY=your-elevenlabs-key
LUMA_API_KEY=your-luma-key
AMBER_API_KEY=your-amber-key

# Server Config
PORT=8080
FLASK_ENV=production
